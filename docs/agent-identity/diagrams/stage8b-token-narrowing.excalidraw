   "x": 520,
   "y": 220,
   "width": 211.68,
   "height": 175.0,
   "text": "the agent client has\nfullScopeAllowed: false\nplus its own scope mappings\n\nToken roles become\n  operator's roles\n  \u2229 agent's scope mappings\n\nNeither side can grant\nwhat the other lacks",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the agent client has\nfullScopeAllowed: false\nplus its own scope mappings\n\nToken roles become\n  operator's roles\n  \u2229 agent's scope mappings\n\nNeither side can grant\nwhat the other lacks",
   "lineHeight": 1.25
  },
