   "x": 1440,
   "y": 220,
   "width": 266.56000000000006,
   "height": 157.5,
   "text": "AuthPolicy on mcp-authz-policy:\n\n  ('tool:' + x-mcp-toolname)\n     in resource_access[...].roles\n  AND azp == 'spiffe://\u2026sandbox'\n\nUnchanged by any of the above \u2014\nit reads ONE role set, which is\nalready the intersection",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "AuthPolicy on mcp-authz-policy:\n\n  ('tool:' + x-mcp-toolname)\n     in resource_access[...].roles\n  AND azp == 'spiffe://\u2026sandbox'\n\nUnchanged by any of the above \u2014\nit reads ONE role set, which is\nalready the intersection",
   "lineHeight": 1.25
  },
