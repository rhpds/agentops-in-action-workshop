   "x": 980,
   "y": 220,
   "width": 250.88000000000002,
   "height": 175.0,
   "text": "the 18 tool-* scopes are DEFAULT\non the agent client\n\nToken carries the operator's\nroles \u2229 the delegable set\n\nNOT one role per call:\nOpenShell's token_grant takes a\nFIXED scopes list, so nothing\ncan vary it per tool call",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the 18 tool-* scopes are DEFAULT\non the agent client\n\nToken carries the operator's\nroles \u2229 the delegable set\n\nNOT one role per call:\nOpenShell's token_grant takes a\nFIXED scopes list, so nothing\ncan vary it per tool call",
   "lineHeight": 1.25
  },
