   "type": "text",
   "x": 62,
   "y": 168,
   "width": 310.8,
   "height": 18.75,
   "text": "TWO SIGNERS, SO TWO FEDERATED CLIENTS",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "TWO SIGNERS, SO TWO FEDERATED CLIENTS",
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 40595,
   "version": 1,
   "versionNonce": 525645,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "backgroundColor": "transparent",
   "strokeColor": "#1e1e1e",
   "id": "e5",
   "type": "text",
   "x": 62,
   "y": 208,
   "width": 525.2800000000001,
   "height": 52.5,
   "text": "Keycloak resolves a federated client by matching the assertion's\nsubject against jwt.credential.sub, and requires exactly ONE match.\nTwo SVIDs sign, so there must be two clients.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Keycloak resolves a federated client by matching the assertion's\nsubject against jwt.credential.sub, and requires exactly ONE match.\nTwo SVIDs sign, so there must be two clients.",
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
