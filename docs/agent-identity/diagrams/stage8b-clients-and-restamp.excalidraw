   "type": "text",
   "x": 62,
   "y": 568,
   "width": 537.6,
   "height": 18.75,
   "text": "COST 1 \u2014 the stored credential expires and cannot refresh itself",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "COST 1 \u2014 the stored credential expires and cannot refresh itself",
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 159380,
   "version": 1,
   "versionNonce": 2096580,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "backgroundColor": "transparent",
   "strokeColor": "#1e1e1e",
   "id": "e20",
   "type": "text",
   "x": 62,
   "y": 606,
   "width": 517.44,
   "height": 70.0,
   "text": "accessTokenLifespan is 1800s, and a broker-only credential \"cannot\ndeclare workload injection metadata such as env vars, static\nplacement, refresh, or token grant metadata\". So something outside\nmust re-stamp it on a timer.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "accessTokenLifespan is 1800s, and a broker-only credential \"cannot\ndeclare workload injection metadata such as env vars, static\nplacement, refresh, or token grant metadata\". So something outside\nmust re-stamp it on a timer.",
   "lineHeight": 1.25
  },
