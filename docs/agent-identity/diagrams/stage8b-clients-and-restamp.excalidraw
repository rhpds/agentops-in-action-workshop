   "x": 80,
   "y": 306,
   "width": 235.20000000000002,
   "height": 17.5,
   "text": "the BROKER \u2014 delegation-broker",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the BROKER \u2014 delegation-broker",
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
