   "id": "e17",
   "type": "text",
   "x": 920,
   "y": 354,
   "width": 444.08000000000004,
   "height": 65.0,
   "text": "gateway_token       NEVER STORED\nminted on demand by the profile's token_grant block.\nThis is what --runtime-credentials would have meant \u2014 and why\nthat flag cannot be used here: it would store nothing at all.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "gateway_token       NEVER STORED\nminted on demand by the profile's token_grant block.\nThis is what --runtime-credentials would have meant \u2014 and why\nthat flag cannot be used here: it would store nothing at all.",
   "lineHeight": 1.25
  },
