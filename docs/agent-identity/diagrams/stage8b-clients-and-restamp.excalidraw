   "width": 995.6800000000001,
   "height": 35.0,
   "text": "Create a client whose clientId is the sandbox SPIFFE ID; mint a token with audience=<that client id> to stand in for the\nintermediate token; exchange it as that client. If it is refused, Decision 1's client layout changes before any of it is built.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Create a client whose clientId is the sandbox SPIFFE ID; mint a token with audience=<that client id> to stand in for the\nintermediate token; exchange it as that client. If it is refused, Decision 1's client layout changes before any of it is built.",
   "lineHeight": 1.25
