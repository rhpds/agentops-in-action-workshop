   "id": "e8",
   "type": "text",
   "x": 80,
   "y": 336,
   "width": 211.12000000000003,
   "height": 81.25,
   "text": "jwt.credential.sub =\n  \u2026/sa/<user>-openshell\n     (the gateway)\n\nsigns hop 2, the intermediate",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "jwt.credential.sub =\n  \u2026/sa/<user>-openshell\n     (the gateway)\n\nsigns hop 2, the intermediate",
   "lineHeight": 1.25
  },
