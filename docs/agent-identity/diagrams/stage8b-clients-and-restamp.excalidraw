   "type": "text",
   "x": 460,
   "y": 336,
   "width": 247.52000000000004,
   "height": 81.25,
   "text": "jwt.credential.sub =\n  \u2026/sa/<user>-openshell-sandbox\n     (the sandbox)\n\nsigns hop 3 \u2014 so its id is the azp",
