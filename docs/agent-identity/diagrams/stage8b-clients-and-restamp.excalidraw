   "id": "e15",
   "type": "text",
   "x": 920,
   "y": 222,
   "width": 422.24000000000007,
   "height": 65.0,
   "text": "operator_token      AT REST   \u2190 set with --credential\nthe human's authorisation. Cannot be derived from an SVID,\nso it is the one thing that must be stored. Broker-only:\nnever injected into the sandbox.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "operator_token      AT REST   \u2190 set with --credential\nthe human's authorisation. Cannot be derived from an SVID,\nso it is the one thing that must be stored. Broker-only:\nnever injected into the sandbox.",
   "lineHeight": 1.25
  },
  {
