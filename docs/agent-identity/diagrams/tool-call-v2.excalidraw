   "link": null,
   "locked": false,
   "backgroundColor": "transparent",
   "strokeColor": "#1e1e1e",
   "id": "e75",
   "type": "text",
   "x": 1342,
   "y": 932.5,
   "width": 444.08000000000004,
   "height": 65.0,
   "text": "One signed token asserting BOTH: the operator is the\nprincipal, the attested sandbox is the actor. Roles are\nalready (operator's roles \u2229 what the agent may be delegated),\nnarrowed to the single tool asked for. No secret involved.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One signed token asserting BOTH: the operator is the\nprincipal, the attested sandbox is the actor. Roles are\nalready (operator's roles \u2229 what the agent may be delegated),\nnarrowed to the single tool asked for. No secret involved.",
   "lineHeight": 1.25
  },
