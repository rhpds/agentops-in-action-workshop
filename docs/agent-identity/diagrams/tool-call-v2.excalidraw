   "id": "e74",
   "type": "text",
   "x": 372,
   "y": 932.5,
   "width": 575.12,
   "height": 81.25,
   "text": "sub              = 959d8fef-\u2026   <- the OPERATOR, the principal\npreferred_username = operator     <- a readable actor, not just a uuid\nazp              = spiffe://\u2026/sa/<user>-openshell-sandbox\naud              = http://mcp-gateway-\u2026:8080/mcp\nresource_access  = { telemetry-mcp: [ tool:get_reservoir_level ] }  <- ONE role",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "sub              = 959d8fef-\u2026   <- the OPERATOR, the principal\npreferred_username = operator     <- a readable actor, not just a uuid\nazp              = spiffe://\u2026/sa/<user>-openshell-sandbox\naud              = http://mcp-gateway-\u2026:8080/mcp\nresource_access  = { telemetry-mcp: [ tool:get_reservoir_level ] }  <- ONE role",
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
