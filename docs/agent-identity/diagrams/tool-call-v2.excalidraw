   "id": "e61",
   "type": "text",
   "x": 1342,
   "y": 747.5,
   "width": 414.96000000000004,
   "height": 32.5,
   "text": "A voucher made out to one bearer. This is what stops a\nsandbox redeeming a token minted for a different sandbox.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A voucher made out to one bearer. This is what stops a\nsandbox redeeming a token minted for a different sandbox.",
