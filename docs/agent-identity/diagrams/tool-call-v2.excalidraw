   "y": 620.0,
   "width": 414.96000000000004,
   "height": 81.25,
   "text": "grant_type=token-exchange\nclient_assertion_type=\u2026jwt-spiffe\nclient_assertion=<GATEWAY SVID>        <- who is asking\nsubject_token=<stored operator token>  <- on whose behalf\naudience=spiffe://\u2026/sa/<user>-openshell-sandbox",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "grant_type=token-exchange\nclient_assertion_type=\u2026jwt-spiffe\nclient_assertion=<GATEWAY SVID>        <- who is asking\nsubject_token=<stored operator token>  <- on whose behalf\naudience=spiffe://\u2026/sa/<user>-openshell-sandbox",
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 428626,
   "version": 1,
   "versionNonce": 5657366,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "backgroundColor": "transparent",
   "strokeColor": "#1e1e1e",
   "id": "e54",
   "type": "text",
   "x": 1342,
   "y": 620.0,
   "width": 444.08000000000004,
   "height": 48.75,
   "text": "Two separate facts in one request. --credential supplies only\nthe subject; the SVID is what replaces the client secret.\nThe audience is fixed by OpenShell and cannot be configured.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Two separate facts in one request. --credential supplies only\nthe subject; the SVID is what replaces the client secret.\nThe audience is fixed by OpenShell and cannot be configured.",
   "lineHeight": 1.25
  },
