   "id": "e39",
   "type": "text",
   "x": 372,
   "y": 470.0,
   "width": 480.48,
   "height": 32.5,
   "text": "FetchJWTSVID(audience = <realm issuer>)\n-> JWT-SVID  sub=spiffe://\u2026/sa/<user>-openshell-sandbox  exp=+5min",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "FetchJWTSVID(audience = <realm issuer>)\n-> JWT-SVID  sub=spiffe://\u2026/sa/<user>-openshell-sandbox  exp=+5min",
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
