   "x": 372,
   "y": 1505.0,
   "width": 407.68000000000006,
   "height": 32.5,
   "text": "GET $PLANT_API_URL/\u2026      no Authorization header at all\nplant-api has no auth env: it is UNAUTHENTICATED",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "GET $PLANT_API_URL/\u2026      no Authorization header at all\nplant-api has no auth env: it is UNAUTHENTICATED",
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
