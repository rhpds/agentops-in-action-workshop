   "id": "e60",
   "type": "text",
   "x": 372,
   "y": 747.5,
   "width": 436.8,
   "height": 48.75,
   "text": "azp = delegation-broker                 (the broker client)\naud = spiffe://\u2026/sa/<user>-openshell-sandbox\n-> useless to any other sandbox: the audience names this one",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "azp = delegation-broker                 (the broker client)\naud = spiffe://\u2026/sa/<user>-openshell-sandbox\n-> useless to any other sandbox: the audience names this one",
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 484059,
