   "width": 342.16,
   "height": 48.75,
   "text": "x-mcp-servername: <user>-agentops/telemetry-mcp\nx-mcp-toolname:   get_reservoir_level\nrouted to listener `mcps` on *.mcp.local",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
