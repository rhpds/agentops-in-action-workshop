   "x": 372,
   "y": 840.0,
   "width": 436.8,
   "height": 48.75,
   "text": "subject_token=<the intermediate>\nclient_assertion=<SANDBOX SVID>        <- a different signer\nscope=tool-get_reservoir_level         <- just this one tool",
   "fontSize": 13,
