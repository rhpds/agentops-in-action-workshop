   "id": "e40",
   "type": "text",
   "x": 1342,
   "y": 470.0,
   "width": 436.8,
   "height": 32.5,
   "text": "No credential is presented: the kernel tells SPIRE which pod\nopened the socket. Being the workload IS the proof.",
