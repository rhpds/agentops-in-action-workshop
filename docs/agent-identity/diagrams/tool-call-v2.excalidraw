   "strokeColor": "#1e1e1e",
   "id": "e81",
   "type": "text",
   "x": 372,
   "y": 1060.0,
   "width": 546.0000000000001,
   "height": 48.75,
   "text": "POST /mcp   {\"method\":\"tools/call\",\"params\":{\"name\":\"get_reservoir_level\"}}\nAuthorization: Bearer ${MCP_GATEWAY_TOKEN}   <- a PLACEHOLDER\nthe supervisor substitutes the real token on the way out",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "POST /mcp   {\"method\":\"tools/call\",\"params\":{\"name\":\"get_reservoir_level\"}}\nAuthorization: Bearer ${MCP_GATEWAY_TOKEN}   <- a PLACEHOLDER\nthe supervisor substitutes the real token on the way out",
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 650358,
   "version": 1,
   "versionNonce": 8589778,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "backgroundColor": "transparent",
   "strokeColor": "#1e1e1e",
   "id": "e82",
   "type": "text",
   "x": 1342,
   "y": 1060.0,
   "width": 436.8,
   "height": 48.75,
   "text": "The agent never holds the Bearer, so a prompt-injected agent\nhas nothing to leak. Resolved only for the endpoints the\nprovider profile declares.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The agent never holds the Bearer, so a prompt-injected agent\nhas nothing to leak. Resolved only for the endpoints the\nprovider profile declares.",
   "lineHeight": 1.25
  },
