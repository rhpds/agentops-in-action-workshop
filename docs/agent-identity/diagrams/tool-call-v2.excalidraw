   "width": 516.8800000000001,
   "height": 48.75,
   "text": "tool-access-check, both predicates AND-ed:\n  ('tool:' + x-mcp-toolname) in resource_access[x-mcp-servername].roles\n  azp == 'spiffe://\u2026/sa/<user>-openshell-sandbox'",
