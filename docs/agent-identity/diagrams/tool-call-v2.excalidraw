   "id": "e117",
   "type": "text",
   "x": 1342,
   "y": 1505.0,
   "width": 436.8,
   "height": 32.5,
   "text": "The honest gap. Identity stops one hop short of the data, so\nthe plant's own audit cannot name the actor. Stage 9.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The honest gap. Identity stops one hop short of the data, so\nthe plant's own audit cannot name the actor. Stage 9.",
