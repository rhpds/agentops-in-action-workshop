  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1222328496,
   "version": 1,
   "versionNonce": 1656961616,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "id": "lgl2",
   "type": "text",
   "x": 60,
   "y": 645,
   "width": 957.5799999999999,
   "height": 48.75,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "text": "An SVID only says \"I am this software\" \u2014 it names no human. So a badge alone can never buy a token that names the operator.\nKeycloak needs the operator's credential too. Whoever holds that credential must NOT be the sandbox, or a prompt-injected agent\ncould mint anything the operator can do. So the gateway holds it \u2014 and must prove who IT is before Keycloak will act on it.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "An SVID only says \"I am this software\" \u2014 it names no human. So a badge alone can never buy a token that names the operator.\nKeycloak needs the operator's credential too. Whoever holds that credential must NOT be the sandbox, or a prompt-injected agent\ncould mint anything the operator can do. So the gateway holds it \u2014 and must prove who IT is before Keycloak will act on it.",
   "lineHeight": 1.25
  }
