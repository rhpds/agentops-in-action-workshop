   "seed": 499897,
   "version": 1,
   "versionNonce": 6599927,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "backgroundColor": "transparent",
   "strokeColor": "#1e1e1e",
   "id": "e63",
   "type": "text",
   "x": 58,
   "y": 1470,
   "width": 757.1200000000001,
   "height": 48.75,
   "text": "jti              identifies the TOKEN. OpenShell caches it, so every call in that window shares one jti.\nx-request-id     identifies the CALL. Envoy generates one per request \u2014 this is the join key.\ntrace id         identifies the TURN. Shared by the agent's spans and, after stage 3, the gateway's.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "jti              identifies the TOKEN. OpenShell caches it, so every call in that window shares one jti.\nx-request-id     identifies the CALL. Envoy generates one per request \u2014 this is the join key.\ntrace id         identifies the TURN. Shared by the agent's spans and, after stage 3, the gateway's.",
   "lineHeight": 1.25
  }
