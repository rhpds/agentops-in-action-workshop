   "id": "e40",
   "type": "text",
   "x": 360,
   "y": 745,
   "width": 451.36000000000007,
   "height": 65.0,
   "text": "X  dropped \u2014 the collector keeps only mcp_method = tools/call.\n(Opening a session costs 3 requests and the broker stamps\nALL of them with the same tool name, so filtering on the tool\nname alone would record one call three times.)",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "X  dropped \u2014 the collector keeps only mcp_method = tools/call.\n(Opening a session costs 3 requests and the broker stamps\nALL of them with the same tool name, so filtering on the tool\nname alone would record one call three times.)",
   "lineHeight": 1.25
  },
