   "x": 1256,
   "y": 962.5,
   "width": 262.08000000000004,
   "height": 130.0,
   "text": "Red Hat OpenTelemetry Collector.\n\nfilter        keep only tools/call\ngroupbyattrs  span attrs -> resource\n              attrs, so MLflow shows\n              them as trace TAGS\nresource      service.name\nbatch         flush after 1s",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Red Hat OpenTelemetry Collector.\n\nfilter        keep only tools/call\ngroupbyattrs  span attrs -> resource\n              attrs, so MLflow shows\n              them as trace TAGS\nresource      service.name\nbatch         flush after 1s",
   "lineHeight": 1.25
  },
