   "type": "text",
   "x": 40,
   "y": 26,
   "width": 722.4000000000001,
   "height": 37.5,
   "text": "How one tool call's identity reaches MLflow",
   "fontSize": 30,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "How one tool call's identity reaches MLflow",
